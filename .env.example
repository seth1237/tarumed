# Copy this file to .env (or set the same keys in Vercel / your host).

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://tarumed.co.ke

# ERP catalog
ERP_API_BASE_URL=https://backend.codewithseth.co.ke
ERP_ORG_ID=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=tarumed

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Admin (created on first login if no admins exist)
ADMIN_EMAIL=admin@tarumed.co.ke
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
